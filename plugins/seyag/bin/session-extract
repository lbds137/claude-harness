#!/bin/bash
# session-extract: turn Claude Code session JSONLs into the two session-mining corpora.
#
# Usage: session-extract [--since ISO-TS] OUTDIR SESSION.jsonl...
#
# For each session file writes, into OUTDIR:
#   <name>.txt        owner lens: user turns plus mid-turn queued messages ([mid-turn]),
#                     deliberately raw (system reminders and compaction summaries kept)
#   <name>.agent.txt  agent lens: assistant text in full, one stub per tool call,
#                     and tool results only when they errored (hook blocks land here)
# --since keeps only entries with a timestamp after ISO-TS (string comparison against
# the logs' UTC stamps, so give it in UTC, e.g. 2026-09-20T06:00).
# Prints one count line per session, named by the first 8 characters only (session ids are
# secrets); a zero count is shown, not hidden. "mid-turn" counts automated traffic too
# (task notifications, Monitor output), not only the owner's messages.

set -uo pipefail
usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in -h | --help) usage; exit 0 ;; esac
since=""
if [ "${1:-}" = "--since" ]; then
  since=${2:?--since needs a timestamp}; shift 2
  # The logs stamp UTC as 2026-09-24T01:15:30.123Z and the filter compares strings, so only a
  # bare UTC prefix of that shape is safe; an offset or a trailing Z would compare wrongly.
  [[ $since =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?Z?$ ]] \
    || { echo "session-extract: --since wants UTC YYYY-MM-DD[THH:MM[:SS]], got: $since" >&2; exit 2; }
  since=${since%Z}
fi
[ $# -ge 2 ] || { usage; exit 2; }
out=$1; shift
mkdir -p "$out" || exit 1

rc=0
for f in "$@"; do
  [ -f "$f" ] || { echo "session-extract: no such file: $f" >&2; rc=1; continue; }
  name=$(basename "$f" .jsonl)
  owner="$out/$name.txt"; agent="$out/$name.agent.txt"

  jq -r --arg s "$since" 'select(($s == "") or ((.timestamp // "") > $s))
    | select(.type == "user" and (.isMeta | not))
    | . as $e
    | ($e.message.content
       | if type == "string" then .
         elif type == "array" then (map(select(.type == "text") | .text) | join("\n"))
         else empty end)
    | select(length > 0)
    | "=== \($e.timestamp) ===\n\(.)\n"' "$f" > "$owner" || rc=1

  jq -r --arg s "$since" 'select(($s == "") or ((.timestamp // "") > $s))
    | select(.type == "queue-operation" and .operation == "enqueue")
    | select((.content // "") | length > 0)
    | "=== \(.timestamp) [mid-turn] ===\n\(.content)\n"' "$f" >> "$owner" || rc=1

  jq -r --arg s "$since" 'select(($s == "") or ((.timestamp // "") > $s))
    | . as $e
    | if $e.type == "assistant" then
        ($e.message.content // [])[]
        | if .type == "text" then "=== \($e.timestamp) [agent] ===\n\(.text)\n"
          elif .type == "tool_use" then "--- \($e.timestamp) tool \(.name): \((.input.command // .input.description // .input.file_path // .input.prompt // .input.skill // .input.query // .input.pattern // .input.message // "") | tostring | .[0:160])"
          else empty end
      elif $e.type == "user" then
        ($e.message.content | if type == "array" then .[] else empty end)
        | select(.type == "tool_result" and .is_error == true)
        | "--- \($e.timestamp) tool-error: \(((.content // "") | if type == "string" then . else (map(.text // "") | join(" ")) end) | .[0:300])"
      else empty end' "$f" > "$agent" || rc=1

  printf '%s…: %s user blocks, %s mid-turn, %s agent blocks, %s tool calls, %s tool errors\n' "${name:0:8}" \
    "$(grep -c '^=== [^[]* ===$' "$owner")" "$(grep -c '\[mid-turn\] ===$' "$owner")" \
    "$(grep -c '\[agent\] ===$' "$agent")" "$(grep -c '^--- .* tool [^:]*:' "$agent")" \
    "$(grep -c '^--- .* tool-error:' "$agent")"
done
exit $rc
