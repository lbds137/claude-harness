#!/usr/bin/env python3
"""usage-sweep: weighted Claude Code token spend from the local session logs.

Sweeps every project folder under ~/.claude/projects (or CLAUDE_PROJECTS_DIR),
main-loop session files and subagents/ files alike, and prints weighted totals
per model, per project folder and main-vs-subagent, plus the live plan meter
from `claude-usage --json` when it is on PATH.

Usage:
  usage-sweep                      since the current weekly window opened
  usage-sweep --since 2026-09-24T01:15Z
  usage-sweep --since 2026-09-24T01:15Z --until 2026-09-24T12:00Z
  usage-sweep --slug -home-deck-Projects-tzurot   (repeatable; default: all)
  usage-sweep --points             also convert each folder's share into meter points,
                                   priced by claude-usage's readings log
  usage-sweep --by-session         attribute per session (slug/session) instead of per folder
  usage-sweep --json               machine-readable output
  usage-sweep --no-dedupe          count every usage line (the old, inflated method)

Claude Code writes each content block of one reply (thinking, text, tool_use)
as its own JSONL line, and every one of those lines repeats the reply's full
usage, with output_tokens growing as the reply streams. Summing lines overcounts;
this script counts each reply (message id + request id) once, at its largest
output_tokens, across all files.

Weights: input 1x, output 5x, cache read 0.1x, cache write 1.25x. They track
the trend and the delegation ratio; the plan meter is the instrument for pace.

Meter-point shares are of the swept set: with --slug the per-slug points sum
to less than the window's total weekly delta.
"""
import argparse
import json
import os
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

USAGE_FIELDS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
WEIGHTS = {"input": 1.0, "output": 5.0, "cache_read": 0.1, "cache_write": 1.25}


def parse_ts(s):
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    dt = datetime.fromisoformat(s)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def meter():
    try:
        out = subprocess.run(["claude-usage", "--json"], capture_output=True, text=True, timeout=30)
        return json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def weigh(u):
    return (
        (u.get("input_tokens") or 0) * WEIGHTS["input"]
        + (u.get("output_tokens") or 0) * WEIGHTS["output"]
        + (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        + (u.get("cache_creation_input_tokens") or 0) * WEIGHTS["cache_write"]
    )


def folder_label(name):
    # Scratchpad-launched sessions get a slug that embeds a session id; never print it.
    return "-tmp* (scratchpad and /tmp sessions)" if name.startswith("-tmp") else name


def readings_log_path():
    # claude-usage appends a reading on each cache refresh; key order is not stable between lines.
    state = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state"
    return Path(state) / "claude-usage" / "readings.jsonl"


def read_readings(path):
    # Returns ([{epoch, weekly_pct, five_hour_pct}, ...], skipped_malformed_count).
    readings, skipped = [], 0
    try:
        fh = open(path, errors="replace")
    except OSError:
        return readings, skipped
    with fh:
        for raw in fh:
            try:
                e = json.loads(raw)
                fh5 = e.get("five_hour_pct")
                readings.append({"epoch": int(e["epoch"]),
                                 "weekly_pct": float(e["weekly_pct"]),
                                 "five_hour_pct": None if fh5 is None else float(fh5)})
            except (AttributeError, KeyError, TypeError, ValueError):
                skipped += 1  # a malformed line, or a JSON-valid one with wrong-typed values
                continue
    readings.sort(key=lambda r: r["epoch"])
    return readings, skipped


def meter_points(readings, x, y):
    # Segment sum between the window edges: a drop between consecutive readings is a
    # meter reset inside the window, so it contributes 0, not a negative delta.
    li = next((i for i in range(len(readings) - 1, -1, -1) if readings[i]["epoch"] <= x), 0)
    ri = next((i for i in range(len(readings)) if readings[i]["epoch"] >= y), len(readings) - 1)
    window = readings[li:ri + 1]
    weekly_delta = five_hour_delta = 0.0
    resets = {"weekly": 0, "five_hour": 0}
    five_hour_ok = True
    for a, b in zip(window, window[1:]):
        d = b["weekly_pct"] - a["weekly_pct"]
        if d > 0:
            weekly_delta += d
        elif d < -0.5:
            resets["weekly"] += 1
        if a["five_hour_pct"] is None or b["five_hour_pct"] is None:
            five_hour_ok = False
            continue
        d = b["five_hour_pct"] - a["five_hour_pct"]
        if d > 0:
            five_hour_delta += d
        elif d < -0.5:
            resets["five_hour"] += 1
    left, right = readings[li], readings[ri]
    return {
        "readings_used": len(window),
        "weekly_delta": weekly_delta,
        "five_hour_delta": five_hour_delta,
        "resets_inside": resets,
        "five_hour_usable": five_hour_ok and resets["five_hour"] == 0,
        "edge_left": {"epoch": left["epoch"], "distance_s": abs(left["epoch"] - x),
                      "extrapolated": left["epoch"] > x},
        "edge_right": {"epoch": right["epoch"], "distance_s": abs(right["epoch"] - y),
                       "extrapolated": right["epoch"] < y},
    }


def files(root, slugs):
    for proj in sorted(p for p in root.iterdir() if p.is_dir()):
        if slugs and proj.name not in slugs:
            continue
        for f in proj.rglob("*.jsonl"):
            if "mined-corpus" in f.parts:
                continue
            yield proj.name, ("subagent" if "subagents" in f.parts else "main"), f


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", help="ISO timestamp (UTC if no offset); default: start of the weekly window")
    ap.add_argument("--until", help="ISO timestamp (UTC if no offset); default: now")
    ap.add_argument("--slug", action="append", default=[], help="project folder name under ~/.claude/projects")
    ap.add_argument("--points", action="store_true",
                    help="convert each folder's share of the window into meter points from claude-usage's readings log")
    ap.add_argument("--by-session", action="store_true",
                    help="attribute usage per session (slug/session) instead of per folder")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-dedupe", action="store_true")
    # Every slug starts with "-", which argparse reads as an option; join "--slug X" into "--slug=X".
    argv, rest = [], sys.argv[1:]
    while rest:
        arg = rest.pop(0)
        argv.append(f"--slug={rest.pop(0)}" if arg == "--slug" and rest else arg)
    a = ap.parse_args(argv)

    m = meter()
    assumed_window = False
    if a.since:
        since = parse_ts(a.since)
    elif m and m.get("weekly_resets_at"):
        since = datetime.fromtimestamp(m["weekly_resets_at"], timezone.utc) - timedelta(days=7)
        assumed_window = True
    else:
        sys.exit("usage-sweep: no --since given and claude-usage --json gave no weekly_resets_at")
    until = parse_ts(a.until) if a.until else datetime.now(timezone.utc)

    root = Path(os.environ.get("CLAUDE_PROJECTS_DIR", Path.home() / ".claude/projects"))
    if not root.is_dir():
        sys.exit(f"usage-sweep: {root} is not a directory")
    unknown = [s for s in a.slug if not (root / s).is_dir()]
    if unknown:
        sys.exit(f"usage-sweep: no such project folder under {root}: {' '.join(unknown)}")

    # Claude Code writes one line per content block of a reply, each repeating the reply's usage;
    # output_tokens grows across those lines as the reply streams, so keep the largest per reply.
    replies = {}
    lines = files_read = skipped = anon = 0
    for slug, scope, f in files(root, set(a.slug)):
        files_read += 1
        # A session is the first path segment under the project folder: s1.jsonl is s1,
        # anything under s1/subagents/ is also s1.
        rel = f.relative_to(root / slug)
        session = rel.parts[0] if len(rel.parts) > 1 else rel.stem
        with open(f, errors="replace") as fh:
            for raw in fh:
                if '"usage"' not in raw:
                    continue
                try:
                    e = json.loads(raw)
                except ValueError:
                    skipped += 1  # a live session's half-written last line
                    continue
                msg = e.get("message") or {}
                u = msg.get("usage")
                if e.get("type") != "assistant" or not u or not e.get("timestamp"):
                    continue
                if not (since < parse_ts(e["timestamp"]) < until):
                    continue
                lines += 1
                if a.no_dedupe or not msg.get("id"):
                    anon += 1
                    key = ("line", anon)
                else:
                    key = (msg.get("id"), e.get("requestId"))
                usage = {k: u.get(k) or 0 for k in USAGE_FIELDS}  # only the counted fields, to keep RAM small
                prev = replies.get(key)
                if prev is None or usage["output_tokens"] > prev[4]["output_tokens"]:
                    replies[key] = (slug, scope, session, msg.get("model") or "?", usage)

    by_model = defaultdict(lambda: defaultdict(float))
    by_slug = defaultdict(float)
    by_scope = defaultdict(float)
    by_session = defaultdict(float)
    for slug, scope, session, model, u in replies.values():
        w = weigh(u)
        d = by_model[model]
        d["weighted"] += w
        d["msgs"] += 1
        d["output"] += u.get("output_tokens") or 0
        d["cache_read_w"] += (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        by_slug[folder_label(slug)] += w
        by_scope[scope] += w
        if a.by_session:
            by_session[f"{folder_label(slug)}/{session}"] += w

    total = sum(d["weighted"] for d in by_model.values())

    points = None
    if a.points:
        rlog = readings_log_path()
        readings, readings_skipped = read_readings(rlog)
        if not readings:
            sys.exit(f"usage-sweep: no usable readings in {rlog} — meter points need the readings log that claude-usage appends on cache refresh")
        points = meter_points(readings, int(since.timestamp()), int(until.timestamp()))
        points["readings_skipped"] = readings_skipped
        points["by_slug"] = {k: round(w / total * points["weekly_delta"], 2) if total else 0.0
                             for k, w in by_slug.items()}
        if a.by_session:
            points["by_session"] = {k: round(w / total * points["weekly_delta"], 2) if total else 0.0
                                    for k, w in by_session.items()}

    result = {
        "since": since.isoformat(),
        "dedupe": not a.no_dedupe,
        "files": files_read,
        "usage_lines": lines,
        "messages_counted": int(sum(d["msgs"] for d in by_model.values())),
        "unparseable_lines": skipped,
        "total_weighted": round(total),
        "by_model": {k: {kk: round(vv) for kk, vv in v.items()} for k, v in by_model.items()},
        "by_slug": {k: round(v) for k, v in by_slug.items()},
        "main_weighted": round(by_scope["main"]),
        "subagent_weighted": round(by_scope["subagent"]),
        "meter": m,
        "window_assumed": assumed_window,
    }
    if points is not None:
        result["points"] = points
    if a.json:
        print(json.dumps(result, indent=2))
        return

    M = 1e6
    print(f"window: since {since:%Y-%m-%d %H:%M}Z  ({files_read} files, {result['messages_counted']} messages"
          f" from {lines} usage lines{'' if a.no_dedupe else ', one count per reply'})")
    print("\nby model:")
    for k, v in sorted(by_model.items(), key=lambda kv: -kv[1]["weighted"]):
        cr = 100 * v["cache_read_w"] / v["weighted"] if v["weighted"] else 0
        print(f"  {k:<32} {v['weighted'] / M:9.1f}M  msgs {int(v['msgs']):6d}  cache-read {cr:3.0f}%")
    print("\nby project folder:")
    for k, v in sorted(by_slug.items(), key=lambda kv: -kv[1]):
        print(f"  {k:<48} {v / M:9.1f}M")
    sub = 100 * by_scope["subagent"] / total if total else 0
    print(f"\nmain loop {by_scope['main'] / M:.1f}M · subagents {by_scope['subagent'] / M:.1f}M"
          f" (delegation {sub:.0f}%)")
    print(f"TOTAL weighted {total / M:.1f}M")
    if m:
        print(f"meter: weekly {m.get('weekly_pct')}% · {m.get('scoped') or 'no per-model cap'}"
              f" · 5h {m.get('five_hour_pct')}%")
        if m.get("weekly_pct"):
            print(f"implied weekly capacity (our weights): {total / (m['weekly_pct'] / 100) / M:.0f}M"
                  " (valid only when --since is the window start)")
    if assumed_window:
        print("window assumed = weekly reset - 7 days; an applied mid-week reset moves the start (pass --since)")
    if skipped:
        print(f"note: {skipped} unparseable line(s) skipped")
    if points is not None:
        print(f"\nmeter points: weekly {points['weekly_delta']:+.1f} pts"
              f" ({points['readings_used']} readings, {points['readings_skipped']} skipped)")
        for k, v in sorted(points["by_slug"].items(), key=lambda kv: -kv[1]):
            share = 100 * by_slug[k] / total if total else 0
            print(f"  {k:<48} {share:5.1f}% / {v:6.2f} pts")
        if a.by_session:
            for k, v in sorted(points["by_session"].items(), key=lambda kv: -kv[1]):
                print(f"  {k:<48} {v:6.2f} pts")
        el, er = points["edge_left"], points["edge_right"]
        if el["extrapolated"]:
            print("note: no reading at/before the window start; the first reading stands in for it")
        if er["extrapolated"]:
            print("note: no reading at/after the window end; the last reading stands in for it")
        if not points["five_hour_usable"]:
            print(f"note: five-hour delta {points['five_hour_delta']:+.1f} pts not usable"
                  f" ({points['resets_inside']['five_hour']} reset(s) inside the window)")
        dist = max(el["distance_s"], er["distance_s"])
        if dist > 7200:
            print(f"note: nearest reading is {dist // 60} min from the window edge; points are approximate")


if __name__ == "__main__":
    main()
