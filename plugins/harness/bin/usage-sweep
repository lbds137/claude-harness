#!/usr/bin/env python3
"""usage-sweep: weighted Claude Code token spend from the local session logs.

Sweeps every project folder under ~/.claude/projects (or CLAUDE_PROJECTS_DIR),
main-loop session files and subagents/ files alike, and prints weighted totals
per model, per project folder and main-vs-subagent, plus the live plan meter
from `claude-usage --json` when it is on PATH.

Usage:
  usage-sweep                      since the current weekly window opened
  usage-sweep --since 2026-09-24T01:15Z
  usage-sweep --slug -home-deck-Projects-tzurot   (repeatable; default: all)
  usage-sweep --json               machine-readable output
  usage-sweep --no-dedupe          count every usage line (the old, inflated method)

Claude Code writes each content block of one reply (thinking, text, tool_use)
as its own JSONL line, and every one of those lines repeats the reply's full
usage, with output_tokens growing as the reply streams. Summing lines overcounts;
this script counts each reply (message id + request id) once, at its largest
output_tokens, across all files.

Weights: input 1x, output 5x, cache read 0.1x, cache write 1.25x. They track
the trend and the delegation ratio; the plan meter is the instrument for pace.
"""
import argparse
import json
import os
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

USAGE_FIELDS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
WEIGHTS = {"input": 1.0, "output": 5.0, "cache_read": 0.1, "cache_write": 1.25}


def parse_ts(s):
    s = s.strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    dt = datetime.fromisoformat(s)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt


def meter():
    try:
        out = subprocess.run(["claude-usage", "--json"], capture_output=True, text=True, timeout=30)
        return json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def weigh(u):
    return (
        (u.get("input_tokens") or 0) * WEIGHTS["input"]
        + (u.get("output_tokens") or 0) * WEIGHTS["output"]
        + (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        + (u.get("cache_creation_input_tokens") or 0) * WEIGHTS["cache_write"]
    )


def folder_label(name):
    # Scratchpad-launched sessions get a slug that embeds a session id; never print it.
    return "-tmp* (scratchpad and /tmp sessions)" if name.startswith("-tmp") else name


def files(root, slugs):
    for proj in sorted(p for p in root.iterdir() if p.is_dir()):
        if slugs and proj.name not in slugs:
            continue
        for f in proj.rglob("*.jsonl"):
            if "mined-corpus" in f.parts:
                continue
            yield proj.name, ("subagent" if "subagents" in f.parts else "main"), f


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", help="ISO timestamp (UTC if no offset); default: start of the weekly window")
    ap.add_argument("--slug", action="append", default=[], help="project folder name under ~/.claude/projects")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--no-dedupe", action="store_true")
    # Every slug starts with "-", which argparse reads as an option; join "--slug X" into "--slug=X".
    argv, rest = [], sys.argv[1:]
    while rest:
        arg = rest.pop(0)
        argv.append(f"--slug={rest.pop(0)}" if arg == "--slug" and rest else arg)
    a = ap.parse_args(argv)

    m = meter()
    assumed_window = False
    if a.since:
        since = parse_ts(a.since)
    elif m and m.get("weekly_resets_at"):
        since = datetime.fromtimestamp(m["weekly_resets_at"], timezone.utc) - timedelta(days=7)
        assumed_window = True
    else:
        sys.exit("usage-sweep: no --since given and claude-usage --json gave no weekly_resets_at")

    root = Path(os.environ.get("CLAUDE_PROJECTS_DIR", Path.home() / ".claude/projects"))
    if not root.is_dir():
        sys.exit(f"usage-sweep: {root} is not a directory")
    unknown = [s for s in a.slug if not (root / s).is_dir()]
    if unknown:
        sys.exit(f"usage-sweep: no such project folder under {root}: {' '.join(unknown)}")

    # Claude Code writes one line per content block of a reply, each repeating the reply's usage;
    # output_tokens grows across those lines as the reply streams, so keep the largest per reply.
    replies = {}
    lines = files_read = skipped = anon = 0
    for slug, scope, f in files(root, set(a.slug)):
        files_read += 1
        with open(f, errors="replace") as fh:
            for raw in fh:
                if '"usage"' not in raw:
                    continue
                try:
                    e = json.loads(raw)
                except ValueError:
                    skipped += 1  # a live session's half-written last line
                    continue
                msg = e.get("message") or {}
                u = msg.get("usage")
                if e.get("type") != "assistant" or not u or not e.get("timestamp"):
                    continue
                if parse_ts(e["timestamp"]) <= since:
                    continue
                lines += 1
                if a.no_dedupe or not msg.get("id"):
                    anon += 1
                    key = ("line", anon)
                else:
                    key = (msg.get("id"), e.get("requestId"))
                usage = {k: u.get(k) or 0 for k in USAGE_FIELDS}  # only the counted fields, to keep RAM small
                prev = replies.get(key)
                if prev is None or usage["output_tokens"] > prev[3]["output_tokens"]:
                    replies[key] = (slug, scope, msg.get("model") or "?", usage)

    by_model = defaultdict(lambda: defaultdict(float))
    by_slug = defaultdict(float)
    by_scope = defaultdict(float)
    for slug, scope, model, u in replies.values():
        w = weigh(u)
        d = by_model[model]
        d["weighted"] += w
        d["msgs"] += 1
        d["output"] += u.get("output_tokens") or 0
        d["cache_read_w"] += (u.get("cache_read_input_tokens") or 0) * WEIGHTS["cache_read"]
        by_slug[folder_label(slug)] += w
        by_scope[scope] += w

    total = sum(d["weighted"] for d in by_model.values())
    result = {
        "since": since.isoformat(),
        "dedupe": not a.no_dedupe,
        "files": files_read,
        "usage_lines": lines,
        "messages_counted": int(sum(d["msgs"] for d in by_model.values())),
        "unparseable_lines": skipped,
        "total_weighted": round(total),
        "by_model": {k: {kk: round(vv) for kk, vv in v.items()} for k, v in by_model.items()},
        "by_slug": {k: round(v) for k, v in by_slug.items()},
        "main_weighted": round(by_scope["main"]),
        "subagent_weighted": round(by_scope["subagent"]),
        "meter": m,
        "window_assumed": assumed_window,
    }
    if a.json:
        print(json.dumps(result, indent=2))
        return

    M = 1e6
    print(f"window: since {since:%Y-%m-%d %H:%M}Z  ({files_read} files, {result['messages_counted']} messages"
          f" from {lines} usage lines{'' if a.no_dedupe else ', one count per reply'})")
    print("\nby model:")
    for k, v in sorted(by_model.items(), key=lambda kv: -kv[1]["weighted"]):
        cr = 100 * v["cache_read_w"] / v["weighted"] if v["weighted"] else 0
        print(f"  {k:<32} {v['weighted'] / M:9.1f}M  msgs {int(v['msgs']):6d}  cache-read {cr:3.0f}%")
    print("\nby project folder:")
    for k, v in sorted(by_slug.items(), key=lambda kv: -kv[1]):
        print(f"  {k:<48} {v / M:9.1f}M")
    sub = 100 * by_scope["subagent"] / total if total else 0
    print(f"\nmain loop {by_scope['main'] / M:.1f}M · subagents {by_scope['subagent'] / M:.1f}M"
          f" (delegation {sub:.0f}%)")
    print(f"TOTAL weighted {total / M:.1f}M")
    if m:
        print(f"meter: weekly {m.get('weekly_pct')}% · {m.get('scoped') or 'no per-model cap'}"
              f" · 5h {m.get('five_hour_pct')}%")
        if m.get("weekly_pct"):
            print(f"implied weekly capacity (our weights): {total / (m['weekly_pct'] / 100) / M:.0f}M"
                  " (valid only when --since is the window start)")
    if assumed_window:
        print("window assumed = weekly reset - 7 days; an applied mid-week reset moves the start (pass --since)")
    if skipped:
        print(f"note: {skipped} unparseable line(s) skipped")


if __name__ == "__main__":
    main()
